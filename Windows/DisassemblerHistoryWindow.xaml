<Window x:Class="VerCheck.Windows.DisassemblerHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:col="clr-namespace:System.Collections;assembly=mscorlib"
        xmlns:local="clr-namespace:VerCheck" 
        xmlns:chart="clr-namespace:Syncfusion.UI.Xaml.Charts;assembly=Syncfusion.SfChart.WPF"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp" 
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:viewModel="clr-namespace:VerCheck.ViewModels"
        xmlns:views="clr-namespace:VerCheck.Views"
        mc:Ignorable="d" 
        MinHeight="700" 
        MinWidth="1300" 
        FontFamily="Montserrat" 
        WindowStyle="None"  
        Background="Transparent"
        AllowsTransparency="True"
        Title="Disassembler History Window">

    <!--Main Section-->
    <Border CornerRadius="0,10,10,0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                <GradientStop Color="{StaticResource primaryBackColor1}" Offset="0"/>
                <GradientStop Color="{StaticResource primaryBackColor2}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <!--Control bar-->
                <RowDefinition Height="25"/>
                <!--Content section-->
                <RowDefinition Height="50"/>
                <!--Content section-->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--Control bar-->
            <StackPanel x:Name="pnlControlBar"
                        Grid.Row="0"
                        Orientation="Horizontal"
                        FlowDirection="RightToLeft"
                        Background="Transparent"
                        Margin="0,0,5,0"
                        MouseLeftButtonDown="pnlControlBar_MouseLeftButtonDown"
                        MouseEnter="pnlControlBar_MouseEnter">
                <!--Close Button-->
                <Button x:Name="btnClose"
                        Style="{DynamicResource controlButton}"
                        Tag="{StaticResource color4}"
                        Click="btnClose_Click">
                    <fa:IconImage Icon="Xmark" Style="{StaticResource controlButtonIcon}"/>
                </Button>
                <!--Maximize Button-->
                <Button x:Name="btnMaximize"
                        Style="{DynamicResource controlButton}"
                        Tag="{StaticResource color6}"
                        Click="btnMaximize_Click">
                    <fa:IconImage Icon="Square" Style="{StaticResource controlButtonIcon}"/>
                </Button>
                <!--Minimize Button-->
                <Button x:Name="btnMinimize"
                        Style="{DynamicResource controlButton}"
                        Tag="{StaticResource color8}"
                        Click="btnMinimize_Click">
                    <fa:IconImage Icon="WindowMinimize" Width="12" Style="{StaticResource controlButtonIcon}"/>
                </Button>
            </StackPanel>
            
            <Border CornerRadius="10"
                 Grid.Row="1"
                 Margin="5">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="0"/>
                        <GradientStop Color="{StaticResource secondaryBackColor2}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <!--Name of file-->
            <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="5">
                <!--Title-->
                <TextBlock Text="File History:"
                                           Foreground="{StaticResource titleColor2}"
                                           FontSize="16"
                                           FontFamily="Montserrat"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                <!--Name-->
                <TextBlock x:Name="FileName"
                                           Foreground="{StaticResource titleColor2}"
                                           FontSize="16"
                                           FontFamily="Montserrat"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
            </StackPanel>
            </Border>

            <UniformGrid Grid.Row="2" Columns="2" Margin="5">
                <Border CornerRadius="10"
                 Grid.Column="0" 
                 Margin="5">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="0"/>
                            <GradientStop Color="{StaticResource secondaryBackColor2}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <!--Line graph for total number of elements-->
                    <lvc:CartesianChart x:Name="HistoryTotalNumberOfCommandsLineChart" Foreground="{StaticResource titleColor2}" LegendLocation="Top">
                        <lvc:CartesianChart.DataTooltip>
                            <lvc:DefaultTooltip Foreground="Black"/>
                        </lvc:CartesianChart.DataTooltip>
                    </lvc:CartesianChart>
                </Border>

                <Border CornerRadius="10"
                 Grid.Column="0" 
                 Margin="5">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="0"/>
                            <GradientStop Color="{StaticResource secondaryBackColor2}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <!--Line graph for total entropy-->
                    <lvc:CartesianChart x:Name="HistoryTotalEntropyLineChart" Grid.Column="0" Foreground="{StaticResource titleColor2}" LegendLocation="Top">
                        <lvc:CartesianChart.DataTooltip>
                            <lvc:DefaultTooltip Foreground="Black"/>
                        </lvc:CartesianChart.DataTooltip>
                    </lvc:CartesianChart>
                </Border>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
